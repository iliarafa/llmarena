# Required at runtime (guest tokens, credits, usage logs).
# Not required for `next build` — the Neon client is created lazily.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# App
NODE_ENV=development
# Optional. Used as a fallback origin for Stripe redirects if the
# request has no Origin header. On Vercel, VERCEL_URL is used automatically.
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — required to purchase credits. App boots without these;
# checkout and webhooks return errors until they are set.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Public key for the browser (renamed from VITE_STRIPE_PUBLIC_KEY)
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_...

# AI providers — optional at boot. Compare still runs; a missing key
# returns a per-model error instead of crashing the process.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Either name works for Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=
OPENROUTER_API_KEY=sk-or-...
