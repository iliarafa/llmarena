# Required to boot (guest tokens, credits, usage logs)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Server
PORT=5000
NODE_ENV=development

# Stripe — required to purchase credits. App boots without these;
# checkout and webhooks return errors until they are set.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...

# AI providers — optional at boot. Compare still runs; a missing key
# returns a per-model error instead of crashing the process.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Either name works for Gemini
GOOGLE_GENERATIVE_AI_API_KEY=
# GOOGLE_API_KEY=
OPENROUTER_API_KEY=sk-or-...
